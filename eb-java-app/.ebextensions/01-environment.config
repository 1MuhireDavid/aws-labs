# Elastic Beanstalk configuration for safe, low-effort rolling releases.
# These settings are versioned with the source bundle so every deployment
# (initial and CI/CD-driven) applies the same, reviewable configuration.

option_settings:
  # Health checks hit "/" which returns a JSON confirmation payload.
  aws:elasticbeanstalk:application:
    Application Healthcheck URL: /

  aws:elasticbeanstalk:environment:process:default:
    HealthCheckPath: /
    MatcherHTTPCode: 200

  # Rolling deployments update instances in batches so the environment
  # stays available during a release and a bad batch can be caught early
  # (satisfies "validate deployments quickly, roll forward with minimal
  # operational effort").
  aws:elasticbeanstalk:command:
    DeploymentPolicy: Rolling
    BatchSizeType: Percentage
    BatchSize: 50

  aws:elasticbeanstalk:healthreporting:system:
    SystemType: enhanced

{
  "family": "ecs-bluegreen-lab-app",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecs-bluegreen-lab-task-execution-role",
  "taskRoleArn": "arn:aws:iam::<AWS_ACCOUNT_ID>:role/ecs-bluegreen-lab-task-role",
  "containerDefinitions": [
    {
      "name": "ecs-bluegreen-lab-container",
      "image": "IMAGE1_NAME",
      "essential": true,
      "portMappings": [
        { "containerPort": 8080, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "APP_OWNER_NAME", "value": "<YOUR_FULL_NAME>" },
        { "name": "LAB_NAME", "value": "ECS Fargate Blue/Green CI/CD Lab" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/ecs-bluegreen-lab-app",
          "awslogs-region": "<AWS_REGION>",
          "awslogs-stream-prefix": "app"
        }
      }
    }
  ]
}

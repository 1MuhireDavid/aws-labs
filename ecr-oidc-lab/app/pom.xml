<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.labs</groupId>
  <artifactId>ecroidcdemo</artifactId>
  <version>1.0.0</version>
  <name>ecr-oidc-lab-app</name>
  <description>Sample Java (Spring Boot) app containerized for the GitHub Actions -> OIDC -> Amazon ECR lab</description>

  <properties>
    <java.version>21</java.version>
    <!-- spring-boot-starter-parent 3.3.4's managed Tomcat (10.1.30) has
         known CRITICAL CVEs (CVE-2025-24813, CVE-2026-41293, CVE-2026-43512,
         CVE-2026-43515) that fail the pipeline's Trivy scan. Spring Boot's
         BOM reads this exact property to version its embedded Tomcat, so
         overriding it here patches the CVEs without needing a full Spring
         Boot upgrade.

         This property has already needed bumping once since: the pipeline's
         own Trivy scan later caught a SECOND round of CRITICAL CVEs
         (CVE-2026-65182, CVE-2026-65905, CVE-2026-68525) in 10.1.55 itself,
         since Apache Tomcat keeps shipping fixes on the 10.1.x line, so this
         value can't be treated as "fixed forever." Per Tomcat's own security
         advisories (https://tomcat.apache.org/security-10.html), all three
         are fixed in 10.1.59, confirmed actually published on Maven Central
         (10.1.58 is not; it appears to have been skipped or pulled).
         Re-check whenever Trivy flags this dependency again. -->
    <tomcat.version>10.1.59</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>

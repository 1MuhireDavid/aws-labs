<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>3.3.4</version>
    <relativePath/>
  </parent>

  <groupId>com.labs</groupId>
  <artifactId>ecroidcdemo</artifactId>
  <version>1.0.0</version>
  <name>ecr-oidc-lab-app</name>
  <description>Sample Java (Spring Boot) app containerized for the GitHub Actions -> OIDC -> Amazon ECR lab</description>

  <properties>
    <java.version>21</java.version>
    <!-- spring-boot-starter-parent 3.3.4's managed Tomcat (10.1.30) has
         known CRITICAL CVEs (CVE-2025-24813, CVE-2026-41293, CVE-2026-43512,
         CVE-2026-43515) that fail the pipeline's Trivy scan. Spring Boot's
         BOM reads this exact property to version its embedded Tomcat, so
         overriding it here patches the CVEs without needing a full Spring
         Boot upgrade. 10.1.55 is Apache's fixed release for all four. -->
    <tomcat.version>10.1.55</tomcat.version>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <finalName>app</finalName>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
    </plugins>
  </build>
</project>
